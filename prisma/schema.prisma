generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Mode {
  online
  offline
  hybrid
}

model Event {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String
  overview    String
  image       String
  venue       String
  location    String
  date        String
  time        String
  mode        Mode
  audience    String
  agenda      String[]
  organizer   String
  tags        String[]
  booking     Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, email])
}
